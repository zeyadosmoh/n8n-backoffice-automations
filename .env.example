# Copy to .env with `python3 scripts/setup_env.py` (generates random secrets, never overwrites). Never commit .env.
# All data in this project is synthetic.

# PostgreSQL 16 (container p8-pg). Host port for tools and tests; n8n uses the service name `postgres`.
POSTGRES_USER=p8
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p8
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5438

# Mock Shopify-style store API (container p8-mock-store, 127.0.0.1:8780).
# n8n sends STORE_API_TOKEN in the X-Shopify-Access-Token header. Admin endpoints (/_admin/*) need MOCK_ADMIN_TOKEN.
STORE_API_URL=http://127.0.0.1:8780
STORE_API_TOKEN=shpat_change-me
MOCK_ADMIN_TOKEN=change-me
MOCK_SEED=42
# Fraction of API requests that fail with a random 5xx (0.0 - 1.0)
MOCK_FAIL_RATE=0.0
# Leaky bucket like Shopify's REST limit: BUCKET requests, refilled at LEAK_RPS per second, then 429 + Retry-After
MOCK_BUCKET_SIZE=40
MOCK_LEAK_RPS=2

# n8n (container p8-n8n, 127.0.0.1:5680)
N8N_ENCRYPTION_KEY=change-me
# Header Auth token for the "run now" webhooks (header X-P8-Token). Lives only here and in the n8n credential.
N8N_WEBHOOK_TOKEN=change-me
# Base URL used to build execution links in failure emails
N8N_EDITOR_BASE_URL=http://localhost:5680
GENERIC_TIMEZONE=Africa/Cairo

# Email (Mailpit catches everything locally: SMTP 127.0.0.1:1026, UI http://127.0.0.1:8026)
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026
ALERT_EMAIL_FROM=automations@store.example.com
ALERT_EMAIL_TO=ops@store.example.com

# Supplier price list: optional AI name-to-SKU matching. Off by default.
# AI matches are NEVER applied; they go to the review list with their confidence.
AI_MATCH_ENABLED=false
AI_MATCH_MIN_CONFIDENCE=0.85
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

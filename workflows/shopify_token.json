{
  "id": "p8ShopifyToken01",
  "name": "P8 · Shopify token (sub-workflow)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b3d9a524-cd1d-5179-a538-b1d953ec73b4",
      "name": "Called by a workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select token, token is not null as hit from (select p8_shopify_token_get($1) as token) t;",
        "options": {
